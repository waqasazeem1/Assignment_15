# ==============================================================================
# LangGraph Multi-Agent Architecture - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Embeddings (OpenAI / OpenRouter / Compatible Providers)
# ------------------------------------------------------------------------------
# Required for live LLM completions. If omitted or left as placeholder,
# the system automatically activates the intelligent OfflineToolCallingLLM.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI-compatible endpoint (e.g., https://openrouter.ai/api/v1 or http://localhost:11434/v1)
OPENAI_BASE_URL=

# Model names
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# 2. RAG & Vector Store Configuration (ChromaDB)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=data/chroma_db
DEFAULT_PDF_PATH=data/sample_documents/sample_agent_guide.pdf
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4

# ------------------------------------------------------------------------------
# 3. GitHub MCP Sub-Agent Configuration
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT).
# Unauthenticated requests work for public repositories (limited to 60 req/hr).
# Add your token to increase rate limit to 5,000 req/hr and allow creating issues.
GITHUB_TOKEN=your_github_personal_access_token_here

# Mode: 'true' to use built-in Python MCP server, 'false' to connect via external npx
USE_NATIVE_GITHUB_MCP=true
GITHUB_MCP_SERVER_COMMAND=npx -y @modelcontextprotocol/server-github

# ------------------------------------------------------------------------------
# 4. Google Workspace Configuration (Calendar & Gmail MCP Sub-Agents)
# ------------------------------------------------------------------------------
# REAL EMAIL SENDING (Gmail SMTP with App Password):
# Recipient ke asli inbox (e.g. wazeem846@gmail.com) par real email bhejne ke liye:
# 1. Google Account > Security > 2-Step Verification on karein
# 2. "App passwords" par ja kar 16-character ka App Password banayein
# 3. Yahan apna Gmail aur 16-digit password likh dein:
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Path to Google Cloud OAuth 2.0 Client credentials JSON file (Optional for live Calendar API)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Set to 'true' to enable built-in sandbox mock calendar & mailbox when
# Google credentials are not yet configured. Enables instant zero-setup testing!
MOCK_MCP_IF_UNCONFIGURED=true

